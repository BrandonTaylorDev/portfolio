# Required in production; Turnstile is disabled by the development server.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional override; defaults to Cloudflare's Siteverify endpoint.
TURNSTILE_CHALLENGE_URI=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Development simulates email delivery unless explicitly enabled.
SMTP2GO_ENABLED=false
SMTP2GO_API_KEY=
SMTP2GO_FROM=
SMTP2GO_TO=
PUBLIC_SMTP2GO_SEND_URI=https://api.smtp2go.com/v3/email/send
